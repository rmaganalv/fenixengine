<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FenixEngine.SettingsPage"
             BackgroundColor="#0B1120"
             Title="Configuración">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Label Text="Configuración del ecosistema" FontSize="26" FontAttributes="Bold" TextColor="White"/>

            <Border Stroke="#1F2937" StrokeThickness="1" BackgroundColor="#111827" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Servicios de IA en la nube" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC"/>
                    <CollectionView x:Name="CloudServicesCollection" ItemsSource="{Binding CloudServices}" SelectionMode="None" HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold"/>
                                        <Label Text="{Binding Provider}" TextColor="#94A3B8"/>
                                    </VerticalStackLayout>
                                    <Switch IsToggled="{Binding Enabled}" IsEnabled="False" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#1F2937" StrokeThickness="1" BackgroundColor="#111827" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Actividad del usuario" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC"/>
                    <Label Text="Se recopilan los eventos de proyectos expuestos y la actividad del usuario en la aplicación." TextColor="#CBD5E1"/>
                    <Button Text="Sincronizar historial" BackgroundColor="#3B82F6" TextColor="White"/>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#1F2937" StrokeThickness="1" BackgroundColor="#111827" Padding="18" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="IA local con Ollama" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC"/>
                    <CollectionView x:Name="LocalAgentsCollection" ItemsSource="{Binding LocalAgents}" SelectionMode="None" HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold"/>
                                        <Label Text="{Binding Endpoint}" TextColor="#94A3B8"/>
                                    </VerticalStackLayout>
                                    <Switch IsToggled="{Binding Enabled}" IsEnabled="False" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
