<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FenixEngine.TaskPage"
             BackgroundColor="#0B1120"
             Title="Tareas">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Tareas por proyecto" FontSize="26" FontAttributes="Bold" TextColor="White"/>

            <CollectionView x:Name="TasksCollectionView" ItemsSource="{Binding TaskGroups}" SelectionMode="None" IsGrouped="True">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1E293B" Padding="12,8" Margin="0,10,0,6">
                            <Label Text="{Binding ProjectName}" TextColor="#67E8F9" FontAttributes="Bold" FontSize="16"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#1F2937" BackgroundColor="#111827" Padding="14" Margin="0,0,0,10" StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{Binding ProjectName}" TextColor="#67E8F9" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{Binding State}" TextColor="#A7F3D0" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Title}" TextColor="White" FontSize="16"/>
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="#CBD5E1"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
