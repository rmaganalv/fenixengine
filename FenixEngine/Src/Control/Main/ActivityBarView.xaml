<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FenixEngine.Src.Control.ActivityBarView">

    <Border Padding="10,10" 
            WidthRequest="80"
            BackgroundColor="{AppThemeBinding Light=#181818, Dark=#181818}"
            StrokeThickness="0">
        
        <!-- Distribuimos los iconos arriba y abajo al estilo VS Code -->
        <Grid RowDefinitions="*, Auto">

            <!-- GRUPO SUPERIOR: Archivos, Ejecutar, Plugins... -->
            <VerticalStackLayout Grid.Row="0" Spacing="12" HorizontalOptions="Center">

                <!-- ICONO 1: Explorador de Archivos -->
                <ImageButton 
                    Source="icon_terminal.png"    
                    WidthRequest="40"
                    HeightRequest="40"
                >
                    <!-- Aquí irán tus iconos (ej. ImageSource / FontImageSource) -->
                </ImageButton>

                <!-- ICONO 2: Run / Debug -->
                <Button WidthRequest="38" HeightRequest="38"
                        CornerRadius="6"
                        BackgroundColor="Transparent"
                        Padding="0"
                        ToolTipProperties.Text="Ejecutar">
                </Button>

                <!-- ICONO 3: Plugins / Extensiones -->
                <Button WidthRequest="38" HeightRequest="38"
                        CornerRadius="6"
                        BackgroundColor="Transparent"
                        Padding="0"
                        ToolTipProperties.Text="Extensiones">
                </Button>

            </VerticalStackLayout>

            <!-- GRUPO INFERIOR: Configuración / Perfil -->
            <VerticalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center">

                <!-- ICONO INFERIOR: Ajustes / Settings -->
                <Button WidthRequest="38" HeightRequest="38"
                        CornerRadius="6"
                        BackgroundColor="Transparent"
                        Padding="0"
                        ToolTipProperties.Text="Configuración">
                </Button>

            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
