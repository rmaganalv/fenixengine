<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FenixEngine.Src.Control.WorkSpaceResponse">

    <Border Padding="15" 
            StrokeShape="RoundRectangle 10"
            BackgroundColor="{AppThemeBinding Light=#181818, Dark=#1E1E1E}">
        
        <VerticalStackLayout Spacing="10">
            <Label Text="Respuesta de la IA:" 
                   FontAttributes="Bold" 
                   FontSize="16" />

            <!-- SCROLL INDEPENDIENTE PARA LA RESPUESTA -->
            <Border StrokeThickness="1" 
                    Stroke="#181818" 
                    Opacity="0.3"
                    Padding="5" 
                    StrokeShape="RoundRectangle 6">
                
                <ScrollView HeightRequest="250" 
                            VerticalScrollBarVisibility="Always">
                    <Editor Text="{Binding ResponseOutput}" 
                            IsReadOnly="True" 
                            TextColor="White"
                            AutoSize="Disabled"
                            BackgroundColor="#181818" />
                </ScrollView>
                
            </Border>
        </VerticalStackLayout>
    </Border>

</ContentView>
