<!-- SeccionUnoView.xaml -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FenixEngine.Src.Control.TaskPanel">




<Border Padding="10,8" 
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">
        
        <Grid ColumnDefinitions="*, Auto, *" 
              ColumnSpacing="12" 
              VerticalOptions="Center">

            <!-- COLUMNA 1: Input URL + Botón Conectar -->
            <Grid Grid.Column="0" 
                  ColumnDefinitions="*, Auto" 
                  ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Text="{Binding Options.BaseUrl}" 
                       Placeholder="http://127.0.0.1:8080/v1/"
                       VerticalOptions="Center" />
                
                <Button Grid.Column="1" 
                        Text="Conectar" 
                        Command="{Binding FetchModelsCommand}"
                        VerticalOptions="Center" />
            </Grid>

            <!-- SEPARADOR VISUAL VERTICAL -->
            <BoxView Grid.Column="1" 
                     WidthRequest="1" 
                     Color="#FFFF4141" 
                     Opacity="0.3" 
                     Margin="4,2" />

            <!-- COLUMNA 2: Selector de Modelo (Picker) -->
            <Grid Grid.Column="2" 
                  ColumnDefinitions="Auto, *" 
                  ColumnSpacing="8">
                <Label Grid.Column="0" 
                       Text="Modelo:" 
                       FontAttributes="Bold" 
                       VerticalOptions="Center" />
                
                <Picker Grid.Column="1" 
                        ItemsSource="{Binding AvailableModels}" 
                        SelectedItem="{Binding Options.SelectedModel}"
                        Title="Seleccionar..."
                        VerticalOptions="Center" />
            </Grid>

        </Grid>
    </Border>




</ContentView>