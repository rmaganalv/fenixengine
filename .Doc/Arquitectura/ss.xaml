<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMasterAgentApp.GestorModelosPage">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="15">
        
        <Label Text="Catálogo de Modelos Locales (Foundry)" 
               FontSize="20" FontAttributes="Bold" Grid.Row="0" />

        <!-- Lista de modelos -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Modelos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" CornerRadius="8">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Descripcion}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding TamanoEstimadoGB, StringFormat='Tamaño: {0:F2} GB'}" FontSize="11" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" 
                                    Text="{Binding EstaDescargado, Converter={StaticResource BoolToTextoConverter}, FallbackValue='Descargar'}"
                                    IsEnabled="{Binding EstaDescargado, Converter={StaticResource InvertBoolConverter}}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GestorModelosViewModel}}, Path=DescargarModeloCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Barra de Progreso de Descarga -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding Descargando}" Spacing="5">
            <Label Text="Descargando modelo local..." HorizontalOptions="Center" />
            <ProgressBar Progress="{Binding ProgresoDescarga}" HeightRequest="10" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>