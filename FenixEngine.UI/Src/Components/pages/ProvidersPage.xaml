<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FenixEngine.UI.ModelView"
             xmlns:models="clr-namespace:FenixEngine.AppCore.Src.Models;assembly=FenixEngine.AppCore"
             x:Class="FenixEngine.UI.ProvidersPage"
             x:DataType="vm:ProvidersPageViewModel"
             Title="Proveedores"
             BackgroundColor="#0B1120">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Proveedores IA" FontSize="22" FontAttributes="Bold" TextColor="#F8FAFC" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Nuevo" Command="{Binding NewCommand}" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="7">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Entry Placeholder="Nombre" Text="{Binding Name}" TextColor="#F8FAFC" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" />
                <Picker Grid.Column="1" Title="Tipo de proveedor" ItemsSource="{Binding ProviderTypes}" SelectedItem="{Binding ProviderType}" TextColor="#F8FAFC" />
            </Grid>
            <Entry Placeholder="URL base" Text="{Binding BaseUrl}" Keyboard="Url" TextColor="#F8FAFC" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" />
            <Grid ColumnDefinitions="*,*,*">
                <HorizontalStackLayout Spacing="6"><Switch IsToggled="{Binding IsLocal}" /><Label Text="Local" TextColor="#E2E8F0" VerticalOptions="Center" /></HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="6"><Switch IsToggled="{Binding IsEnabled}" /><Label Text="Habilitado" TextColor="#E2E8F0" VerticalOptions="Center" /></HorizontalStackLayout>
                <Label Grid.Column="2" Text="{Binding ApiKeyConfigured, StringFormat='API key guardada: {0}'}" TextColor="#94A3B8" VerticalOptions="Center" FontSize="12" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Placeholder="API key (vacío conserva la actual)" Text="{Binding ApiKey}" IsPassword="True" TextColor="#F8FAFC" PlaceholderColor="#94A3B8" BackgroundColor="#1F2937" />
                <HorizontalStackLayout Grid.Column="1" Spacing="4"><CheckBox IsChecked="{Binding ClearApiKey}" /><Label Text="Quitar key" TextColor="#E2E8F0" VerticalOptions="Center" FontSize="12" /></HorizontalStackLayout>
            </Grid>
            <HorizontalStackLayout Spacing="8">
                <Button Text="Guardar" Command="{Binding SaveCommand}" />
                <Button Text="Probar conexión" Command="{Binding TestConnectionCommand}" />
                <Button Text="Eliminar" Command="{Binding DeleteCommand}" BackgroundColor="#7F1D1D" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}" SelectionMode="Single">
            <CollectionView.EmptyView><Label Text="No hay proveedores registrados." TextColor="#94A3B8" VerticalOptions="Center" HorizontalOptions="Center" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AiProviderDto">
                    <Border Margin="0,3" Padding="10" Stroke="#334155" StrokeThickness="1" BackgroundColor="#111827" StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Name}" TextColor="#F8FAFC" FontAttributes="Bold" />
                                <Label Text="{Binding ProviderType}" TextColor="#CBD5E1" FontSize="12" />
                                <Label Text="{Binding BaseUrl}" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding IsEnabled, StringFormat='Activo: {0}'}" TextColor="#86EFAC" FontSize="12" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Grid.Row="3" Text="{Binding StatusMessage}" TextColor="#93C5FD" FontSize="12" />
    </Grid>
</ContentPage>